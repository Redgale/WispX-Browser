{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@sj-dist/*": ["./node_modules/@mercuryworkshop/scramjet/dist/*"],
      "@epoxy": ["./vendor/epoxy-tls/epoxy-bundled.js"]
    }
  },
  "include": ["src"]
}
